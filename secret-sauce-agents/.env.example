# Copy to .env (gitignored) and adjust paths for your machine.
# Google Drive for desktop path to "Secret Sauce Agents/inbox", e.g. on macOS:
SECRET_SAUCE_INBOX="~/Library/CloudStorage/GoogleDrive-<your-account>/My Drive/Secret Sauce Agents/inbox"
SECRET_SAUCE_FIXTURES="~/Library/CloudStorage/GoogleDrive-<your-account>/My Drive/Secret Sauce Agents/fixtures"
# Where the daily dashboard (HTML + PDF) is saved. Defaults to the "dashboard" folder next to
# SECRET_SAUCE_INBOX, i.e. "Secret Sauce Agents/dashboard" in Drive.
# SECRET_SAUCE_DASHBOARD_DIR="~/Library/CloudStorage/GoogleDrive-<your-account>/My Drive/Secret Sauce Agents/dashboard"
# Only needed if Chrome is not in a standard location:
# CHROME_BIN="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
