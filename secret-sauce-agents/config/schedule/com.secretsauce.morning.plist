<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd job: runs scripts/run_morning.sh daily at 06:00 in the Mac's local time zone.
     Replace REPO_PATH with the absolute path to secret-sauce-agents. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.secretsauce.morning</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPO_PATH/scripts/run_morning.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>REPO_PATH/logs/runs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>REPO_PATH/logs/runs/launchd.err.log</string>
</dict>
</plist>
